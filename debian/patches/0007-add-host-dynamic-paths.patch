+    // Mount only the current user's persistent directory /persistent/$HOME
+    // instead of the whole /persistent, so other users' persistent data stays
+    // out of the container view. $HOME comes from getenv("HOME") at runtime;
+    // unsafe values (unset/empty/root/".." escape) are filtered out below.
+    if (const auto *homeEnv = ::getenv("HOME"); homeEnv != nullptr && *homeEnv != '\0') {
+        const auto homeRelative = std::filesystem::path(homeEnv).relative_path();
+        const auto persistentHome =
+          (std::filesystem::path{ "/persistent" } / homeRelative).lexically_normal().string();
+        if (homeRelative.empty() || persistentHome == "/persistent"
+            || persistentHome == "/persistent/" || persistentHome.rfind("/persistent/", 0) != 0) {
+            LogW("unsafe HOME '{}', skip mounting /persistent/$HOME", homeEnv);
+        } else {
+            hostDynamic.emplace_back(api::types::v1::Mount{
+              .destination = persistentHome,
+              .options = std::vector<std::string>{ "rbind", "rw", "rslave" },
+              .source = persistentHome,
+              .srcType = std::nullopt,
+              .type = "bind",
+            });
+        }
+    } else {
+        LogW("HOME is not set, skip mounting /persistent/$HOME");
+    }
+
